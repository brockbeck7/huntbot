# ── HuntBot Environment Variables ──────────────────────────────────────────
# Copy this file to .env and populate the values you need.
# Never commit .env to version control.

# Local LLM server endpoint (Ollama default shown)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=not-needed

# Log backend: mock | file | azure
LOG_BACKEND=mock

# File backend: path to directory containing <TableName>.jsonl files
LOCAL_LOG_DIR=./logs

# Azure Monitor / Sentinel backend
AZURE_WORKSPACE_ID=your-log-analytics-workspace-id

# Azure AD app registration (required for live Sentinel queries + MDE remediation)
AAD_TENANT_ID=your-tenant-id
AAD_CLIENT_ID=your-client-id
AAD_CLIENT_SECRET=your-client-secret
