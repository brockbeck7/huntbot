# ── HuntBot Environment Variables ──────────────────────────────────────────
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=not-needed

LOG_BACKEND=mock
LOCAL_LOG_DIR=./logs

AZURE_WORKSPACE_ID=your-log-analytics-workspace-id
AAD_TENANT_ID=your-tenant-id
AAD_CLIENT_ID=your-client-id
AAD_CLIENT_SECRET=your-client-secret

# Email alerts for Critical findings (leave SMTP_HOST blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-app-password
ALERT_FROM=huntbot@localhost
ALERT_TO=your@email.com
